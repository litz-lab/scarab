# Writes OUT, a C++ table of every src/ramulator2/*.yaml (in DIR), so that a scarab binary carries
# the Ramulator 2 configs it was built with and ramulator2_config can name one without a path.
# Run at build time by the add_custom_command in src/CMakeLists.txt; OUT is only rewritten when
# its contents change.
file(GLOB yamls ${DIR}/*.yaml)
list(SORT yamls)
set(text "// Generated by src/ramulator2/embed_configs.cmake from src/ramulator2/*.yaml. Do not edit.\n")
string(APPEND text "#include \"ramulator2_configs.h\"\n\n")
string(APPEND text "const Ramulator2_Builtin_Config ramulator2_builtin_configs[] = {\n")
set(count 0)
foreach(yaml IN LISTS yamls)
  get_filename_component(name ${yaml} NAME_WE)
  file(READ ${yaml} body)
  string(FIND "${body}" ")ramulator2_yaml\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${yaml} contains the raw-string delimiter )ramulator2_yaml\"")
  endif()
  string(APPEND text "    {\"${name}\", R\"ramulator2_yaml(${body})ramulator2_yaml\"},\n")
  math(EXPR count "${count} + 1")
endforeach()
string(APPEND text "};\nconst unsigned ramulator2_num_builtin_configs = ${count};\n")
file(WRITE ${OUT}.tmp "${text}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
